{
  "name": "mk-webpack-react",
  "version": "1.0.0",
  "description": "MK_Webpack_React - A modern React application built with Webpack 5, TypeScript, and SCSS. Features modular components, W3C standards compliance, and comprehensive accessibility features.",
  "main": "src/index.tsx",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack",
    "build:prod": "webpack --mode production",
    "watch": "webpack --watch",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,scss,css,json}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": {
    "name": "KUNAAL MANGAL",
