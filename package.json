  "repository": {
    "type": "git",
    "url": "https://github.com/KunaalMangal/MK_Webpack_React.git"
  },
  "homepage": "https://kunaalmangal.github.io/MK_Webpack_React",
  "bugs": {
    "url": "https://github.com/KunaalMangal/MK_Webpack_React/issues"
  },
  "keywords": [
    "react",
    "typescript",
